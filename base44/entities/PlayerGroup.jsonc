{
  "name": "PlayerGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "players"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}